#!/bin/sh
set -e
case "$1" in
  configure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
      systemctl enable cloudzero-bridge.service || true
      systemctl restart cloudzero-bridge.service || systemctl start cloudzero-bridge.service || true
    fi
    ;;
esac
exit 0
