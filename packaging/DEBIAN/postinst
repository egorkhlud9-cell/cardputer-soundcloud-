#!/bin/sh
set -e

# Retire only known legacy CloudZero service launchers. Do not recursively
# delete application directories or user data during package installation.
systemctl disable --now cloudzero-bridge.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/cloudzero-bridge.service
rm -f /etc/systemd/system/multi-user.target.wants/cloudzero-bridge.service
rm -f /lib/systemd/system/cloudzero-bridge.service
rm -f /usr/lib/systemd/system/cloudzero-bridge.service
rm -f /etc/systemd/user/cloudzero-bridge.service
rm -f /usr/lib/systemd/user/cloudzero-bridge.service
for home in /home/* /root; do
  [ -d "$home" ] || continue
  rm -f "$home/.config/systemd/user/cloudzero-bridge.service"
  rm -f "$home/.config/systemd/user/default.target.wants/cloudzero-bridge.service"
done
rm -f /usr/local/bin/cloudzero /usr/bin/cloudzero
systemctl daemon-reload >/dev/null 2>&1 || true

# The app reads the Cardputer keyboard through Linux evdev. Grant the
# installing desktop user access to input devices when installed via sudo.
target_user="${SUDO_USER:-}"
if [ -n "$target_user" ] && [ "$target_user" != root ] && getent group input >/dev/null 2>&1; then
  if ! id -nG "$target_user" | tr ' ' '\n' | grep -qx input; then
    usermod -aG input "$target_user" || true
  fi
fi

chmod 755 /usr/bin/soundcloud-cardputer
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
exit 0
